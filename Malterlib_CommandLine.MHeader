Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_CommandLine}"
{
	%Group "CommandLine"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/CommandLine/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_CommandLine define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "CommandLine"
	{
		!!MalterlibLibrary_CommandLine true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_CommandLine define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_CommandLine true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_CommandLine"
	MalterlibTestFiles_Malterlib_CommandLine define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

