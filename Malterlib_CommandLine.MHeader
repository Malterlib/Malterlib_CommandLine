Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_CommandLine}"
{
	%Group "CommandLine"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/CommandLine/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_CommandLine true
	{
		&
		{
			MalterlibLibrary_CommandLine ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "CommandLine;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_CommandLine true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_CommandLine true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_CommandLine true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_CommandLine;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_CommandLine "@('Test/*'->MakeAbsolute())"
}

